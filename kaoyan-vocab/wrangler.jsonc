{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaoyan-vocab",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./deploy-public",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaoyan-progress",
      "database_id": "1fec5b85-936a-4d21-9774-2bda0f3965d3"
    }
  ],
  "observability": { "enabled": true }
}
